{
  "name": "hue-sc-app",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test:auth": "node --test tests/auth.integration.test.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.16",
    "@pinia/nuxt": "^0.11.0",
    "axios": "^1.5.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "postcss": "^8.4.29",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.3"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
